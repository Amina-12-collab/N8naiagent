    {
      "parameters": {
        "jsCode": "const body = ($('Webhook').first().json.body) || {};\nconst question = String(body.question || body.prompt || body.message || '').trim();\nif (!question) {\n  return [{ json: { valid: false, error: 'Missing required field: question', prompt: '' } }];\n}\nconst stored = $input.first() ? ($input.first().json || {}) : {};\nconst fromBody = (typeof body.pdfText === 'string') ? body.pdfText.trim() : '';\nconst fromStore = (typeof stored.pdf_text === 'string') ? stored.pdf_text.trim() : '';\nconst pdfText = fromBody || fromStore;\nconst mentionsPdf = /\\b(pdf|uploaded|upload|document|file)\\b/i.test(question) || fromBody !== '';\nif (mentionsPdf) {\n  if (!pdfText) {\n    return [{ json: { valid: false, error: 'No PDF text is available. Please upload a PDF first, then ask for the quiz again.', prompt: '' } }];\n  }\n  const prompt = 'Use ONLY the PDF text below. Do not use outside knowledge.\\n\\nPDF TEXT:\\n' + pdfText + '\\n\\nREQUEST:\\n' + question;\n  return [{ json: { valid: true, usesPdf: true, error: '', prompt } }];\n}\nreturn [{ json: { valid: true, usesPdf: false, error: '', prompt: question } }];"
      },
      "id": "7ea7ca91-ef96-4e5a-9d7a-cfaee5de19ae",
      "name": "Prepare Quiz Input",
